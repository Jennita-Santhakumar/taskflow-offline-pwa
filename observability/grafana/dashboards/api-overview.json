{
  "title": "Task Platform API Overview",
  "timezone": "browser",
  "panels": [
    {
      "type": "graph",
      "title": "Request rate by endpoint",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(rate(http_requests_total[1m])) by (handler)" }]
    },
    {
      "type": "graph",
      "title": "p95 request latency",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, handler))" }
      ]
    },
    {
      "type": "graph",
      "title": "Recommendations endpoint latency",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{handler=\"/recommendations/next-tasks\"}[5m])) by (le))"
        }
      ]
    },
    {
      "type": "graph",
      "title": "5xx error rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{ "expr": "sum(rate(http_requests_total{status=~\"5..\"}[1m]))" }]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
